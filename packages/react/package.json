{
  "name": "@opensymbols/react",
  "version": "0.1.0",
  "description": "React components for generated OpenSymbols data.",
  "keywords": [
    "sf-symbols",
    "icons",
    "react",
    "svg",
    "components",
    "opensymbols"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/check-pack.mjs --require-pnpm && pnpm --filter @opensymbols/react... build && node ../../scripts/check-pack.mjs --package .",
    "prepublishOnly": "node ../../scripts/check-pack.mjs --require-pnpm"
  },
  "dependencies": {
    "@opensymbols/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^21.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
