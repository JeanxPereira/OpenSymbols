{
  "name": "@opensymbols/react",
  "version": "0.0.0",
  "description": "React components for generated OpenSymbols data.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
