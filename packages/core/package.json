{
  "name": "@opensymbols/core",
  "version": "0.1.0",
  "description": "Framework-free runtime for generated OpenSymbols data: format types and weight interpolation.",
  "keywords": [
    "sf-symbols",
    "icons",
    "svg",
    "variable-weight",
    "opensymbols"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/check-pack.mjs --require-pnpm && pnpm --filter @opensymbols/core... build && node ../../scripts/check-pack.mjs --package .",
    "prepublishOnly": "node ../../scripts/check-pack.mjs --require-pnpm"
  },
  "publishConfig": {
    "access": "public"
  }
}
