{
  "name": "opensymbols-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.0",
  "engines": { "node": ">=24.2" },
  "scripts": {
    "build": "pnpm --filter \"demo...\" build && pnpm --filter \"!demo...\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build && vitest run --passWithNoTests && node --test \"scripts/*.test.mjs\"",
    "check:pack": "pnpm build && node scripts/check-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
